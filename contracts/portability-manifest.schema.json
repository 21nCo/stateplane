{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateplane.dev/contracts/portability-manifest/1.schema.json",
  "title": "Stateplane space export, format version 1",
  "description": "The manifest of a space export (its last part) and, under $defs, one NDJSON line of each section. The format's own objects (the manifest and each section line's envelope) are closed (additionalProperties false): a member not listed here is not part of format version 1. The canonical JSON members ($defs/json: records and revisions data, schema definitions, extraction sourceOffsets) and the free-text members hold user content as stored, which this schema does not inspect. Credential secrets, session tokens and storage object keys stay out because the exporter never reads them, not because of this schema. docs/portability-export.md states the format's rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "jobId", "space", "boundary", "sections", "parts", "excluded"],
  "properties": {
    "format": { "const": "stateplane.space-export" },
    "formatVersion": { "const": 1 },
    "jobId": { "type": "string", "pattern": "^exp_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "space": {
      "type": "object", "additionalProperties": false,
      "required": ["spaceId", "ownerPrincipalId", "policyVersion", "placementGeneration"],
      "properties": {
        "spaceId": { "$ref": "#/$defs/id" }, "ownerPrincipalId": { "$ref": "#/$defs/id" },
        "policyVersion": { "$ref": "#/$defs/positive" }, "placementGeneration": { "$ref": "#/$defs/positive" }
      }
    },
    "boundary": {
      "description": "Records are as of watermark, a position of the cell's record event feed; every other section as of snapshotAt, the instant the watermark was pinned while writes to the space were held. Both name the same state.",
      "type": "object", "additionalProperties": false,
      "required": ["watermark", "snapshotAt", "records", "evidence"],
      "properties": {
        "watermark": { "$ref": "#/$defs/count" }, "snapshotAt": { "$ref": "#/$defs/rfc3339" },
        "records": { "const": "as-of-watermark" }, "evidence": { "const": "as-of-snapshot" }
      }
    },
    "sections": {
      "description": "Every evidence section, once each and in this order, each with its total rows and bytes; then, optionally, the accelerator section embeddings, never the only copy of anything.",
      "type": "array", "minItems": 11, "maxItems": 12,
      "prefixItems": [
        { "$ref": "#/$defs/evidenceSection", "properties": { "name": { "const": "permissions" } } },
        { "$ref": "#/$defs/evidenceSection", "properties": { "name": { "const": "schemas" } } },
        { "$ref": "#/$defs/evidenceSection", "properties": { "name": { "const": "retrieval" } } },
        { "$ref": "#/$defs/evidenceSection", "properties": { "name": { "const": "sources" } } },
        { "$ref": "#/$defs/evidenceSection", "properties": { "name": { "const": "extractions" } } },
        { "$ref": "#/$defs/evidenceSection", "properties": { "name": { "const": "claims" } } },
        { "$ref": "#/$defs/evidenceSection", "properties": { "name": { "const": "provenance" } } },
        { "$ref": "#/$defs/evidenceSection", "properties": { "name": { "const": "links" } } },
        { "$ref": "#/$defs/evidenceSection", "properties": { "name": { "const": "events" } } },
        { "$ref": "#/$defs/evidenceSection", "properties": { "name": { "const": "records" } } },
        { "$ref": "#/$defs/evidenceSection", "properties": { "name": { "const": "revisions" } } }
      ],
      "items": { "$ref": "#/$defs/section", "properties": { "name": { "const": "embeddings" }, "accelerator": { "const": true } } }
    },
    "parts": {
      "description": "Every data part, numbered from 1 without gaps, each one section's NDJSON from where that section's previous part stopped (a line may continue into the next part). rows counts the lines that end in the part. The manifest itself is the part after the last listed.",
      "type": "array", "maxItems": 4095,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["number", "section", "rows", "bytes", "sha256"],
        "properties": {
          "number": { "$ref": "#/$defs/positive" },
          "section": { "enum": ["permissions", "schemas", "retrieval", "sources", "extractions", "claims", "provenance", "links", "events", "records", "revisions", "embeddings"] },
          "rows": { "$ref": "#/$defs/count" },
          "bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "excluded": { "type": "array", "items": { "type": "string" } }
  },
  "if": { "properties": { "sections": { "maxItems": 11 } } },
  "then": { "properties": { "parts": { "items": { "properties": { "section": { "not": { "const": "embeddings" } } } } } } },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "section": { "type": "object", "additionalProperties": false, "required": ["name", "rows", "bytes", "accelerator"],
      "properties": { "name": { "type": "string" }, "rows": { "$ref": "#/$defs/count" }, "bytes": { "$ref": "#/$defs/count" },
        "accelerator": { "type": "boolean" } } },
    "evidenceSection": { "$ref": "#/$defs/section", "properties": { "accelerator": { "const": false } } },
    "count": { "type": "integer", "minimum": 0 },
    "positive": { "type": "integer", "minimum": 1 },
    "rfc3339": { "description": "An RFC 3339 date-time without a leap second: a date (the pattern checks its fields by range only, month 01 to 12 and day 01 to 31, so a day its month lacks, such as 2026-02-31, is refused only by a validator that asserts format date-time, for example ajv-formats), T or t, a time of day (hour 00 to 23, minute and second 00 to 59) and Z, z or a +HH:MM or -HH:MM offset. Format version 1 never carries a second of 60: its instants are database clock readings, which have none.", "type": "string", "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" },
    "instant": { "description": "A stored instant exactly as the database holds it: UTC, to the microsecond.", "$ref": "#/$defs/rfc3339",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$" },
    "optionalInstant": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/instant" }] },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "versionPredecessor": { "description": "previousVersion is the generated NULLIF(version - 1, 0): null exactly at version 1. That it equals version - 1 is a rule no JSON Schema states.",
      "if": { "properties": { "version": { "const": 1 } } }, "then": { "properties": { "previousVersion": { "type": "null" } } }, "else": { "properties": { "previousVersion": { "type": "integer" } } } },
    "revisionPredecessor": { "description": "previousRevision as versionPredecessor, of revision.",
      "if": { "properties": { "revision": { "const": 1 } } }, "then": { "properties": { "previousRevision": { "type": "null" } } }, "else": { "properties": { "previousRevision": { "type": "integer" } } } },
    "keyMode": { "description": "How a record is keyed: external (key is its normalized external key, reserved even once the record is deleted) or generated (key is its ID).", "enum": ["generated", "external"] },
    "json": { "description": "Canonical JSON, kept byte for byte." },
    "schemas": {
      "description": "One accepted version of a collection's definition.",
      "type": "object", "additionalProperties": false, "required": ["collectionId", "version", "acceptedAt", "definition"],
      "properties": { "collectionId": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/positive" },
        "acceptedAt": { "$ref": "#/$defs/instant" }, "definition": { "$ref": "#/$defs/json" } }
    },
    "retrieval": {
      "description": "One version of a collection's retrieval policy: what is projected, never a projection.",
      "type": "object", "additionalProperties": false, "$ref": "#/$defs/versionPredecessor",
      "required": ["collectionId", "version", "previousVersion", "recordFields", "sourceContent", "claimStatements", "lexical", "vector", "textSearchConfig", "processingRegions", "credentialId", "createdAt"],
      "properties": { "collectionId": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/positive" },
        "previousVersion": { "type": ["integer", "null"], "minimum": 1 }, "recordFields": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^(/([^~/]|~[01])*)+$" } },
        "sourceContent": { "type": "boolean" }, "claimStatements": { "type": "boolean" }, "lexical": { "type": "boolean" },
        "vector": { "type": "boolean" }, "textSearchConfig": { "type": "string", "pattern": "^[a-z_]{1,63}$" },
        "processingRegions": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" } }, "credentialId": { "$ref": "#/$defs/id" },
        "createdAt": { "$ref": "#/$defs/instant" } },
      "if": { "properties": { "vector": { "const": true } } }, "then": { "properties": { "processingRegions": { "minItems": 1 } } }
    },
    "permissions": {
      "description": "One agent credential's identity, times and collection grants. Never a secret, its hash or a token: an importer reissues credentials.",
      "type": "object", "additionalProperties": false,
      "required": ["credentialId", "principalId", "createdAt", "expiresAt", "activatedAt", "confirmedAt", "revokedAt", "grants"],
      "properties": { "credentialId": { "$ref": "#/$defs/id" }, "principalId": { "$ref": "#/$defs/id" },
        "createdAt": { "$ref": "#/$defs/instant" }, "expiresAt": { "$ref": "#/$defs/instant" },
        "activatedAt": { "$ref": "#/$defs/optionalInstant" }, "confirmedAt": { "$ref": "#/$defs/optionalInstant" },
        "revokedAt": { "$ref": "#/$defs/optionalInstant" },
        "grants": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["collectionId", "capabilities", "expiresAt"],
          "properties": { "collectionId": { "$ref": "#/$defs/id" }, "capabilities": { "type": "array", "items": { "enum": ["schema:write", "records:read", "records:write", "sources:read", "sources:write", "claims:read", "claims:write", "claims:review", "events:read", "export:read", "space:admin"] } },
            "expiresAt": { "$ref": "#/$defs/optionalInstant" } } } } }
    },
    "sources": {
      "description": "One live source with its original's digest, size and type. Original bytes travel apart from the export and are checked against sha256; the storage key is never exported.",
      "type": "object", "additionalProperties": false,
      "required": ["collectionId", "sourceId", "kind", "locator", "principalId", "credentialId", "createdAt", "original"],
      "properties": { "collectionId": { "$ref": "#/$defs/id" }, "sourceId": { "$ref": "#/$defs/id" }, "kind": { "const": "source" },
        "locator": { "type": ["string", "null"], "minLength": 1 }, "principalId": { "$ref": "#/$defs/id" }, "credentialId": { "$ref": "#/$defs/id" },
        "createdAt": { "$ref": "#/$defs/instant" },
        "original": { "type": "object", "additionalProperties": false,
          "required": ["referenceOnly", "sha256", "byteSize", "mimeType", "capturedAt", "observedAt"],
          "properties": { "referenceOnly": { "type": "boolean" }, "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
            "byteSize": { "type": ["integer", "null"], "minimum": 0 },
            "mimeType": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$" },
            "capturedAt": { "$ref": "#/$defs/instant" }, "observedAt": { "$ref": "#/$defs/instant" } },
          "if": { "properties": { "referenceOnly": { "const": true } } }, "then": { "properties": { "sha256": { "type": "null" }, "byteSize": { "type": "null" } } },
          "else": { "properties": { "sha256": { "type": "string" }, "byteSize": { "type": "integer" }, "mimeType": { "type": "string" } } } } }
    },
    "extractions": {
      "description": "One extraction version of a live source.",
      "type": "object", "additionalProperties": false, "$ref": "#/$defs/versionPredecessor",
      "required": ["collectionId", "sourceId", "version", "previousVersion", "sourceSha256", "parser", "parserVersion", "credentialId", "createdAt", "content", "sourceOffsets"],
      "properties": { "collectionId": { "$ref": "#/$defs/id" }, "sourceId": { "$ref": "#/$defs/id" }, "version": { "$ref": "#/$defs/positive" },
        "previousVersion": { "type": ["integer", "null"], "minimum": 1 }, "sourceSha256": { "$ref": "#/$defs/sha256" }, "parser": { "type": "string", "minLength": 1 },
        "parserVersion": { "type": "string", "minLength": 1 }, "credentialId": { "$ref": "#/$defs/id" }, "createdAt": { "$ref": "#/$defs/instant" },
        "content": { "type": "string" }, "sourceOffsets": { "$ref": "#/$defs/json" } }
    },
    "claims": {
      "description": "One revision of a live claim.",
      "type": "object", "additionalProperties": false, "$ref": "#/$defs/revisionPredecessor",
      "required": ["collectionId", "claimId", "revision", "kind", "principalId", "createdAt", "previousRevision", "statement", "attributedTo", "credentialId", "recordedBy", "observedAt", "validFrom", "validUntil", "reviewStatus", "reviewedBy", "reviewedAt", "committedAt"],
      "properties": { "collectionId": { "$ref": "#/$defs/id" }, "claimId": { "$ref": "#/$defs/id" }, "revision": { "$ref": "#/$defs/positive" },
        "kind": { "const": "claim" }, "principalId": { "$ref": "#/$defs/id" }, "createdAt": { "$ref": "#/$defs/instant" },
        "previousRevision": { "type": ["integer", "null"], "minimum": 1 }, "statement": { "type": "string", "minLength": 1 }, "attributedTo": { "type": "string", "minLength": 1 },
        "credentialId": { "$ref": "#/$defs/id" }, "recordedBy": { "type": ["string", "null"], "minLength": 1 },
        "observedAt": { "$ref": "#/$defs/optionalInstant" }, "validFrom": { "$ref": "#/$defs/optionalInstant" },
        "validUntil": { "$ref": "#/$defs/optionalInstant" }, "reviewStatus": { "enum": ["unreviewed", "accepted", "rejected"] },
        "reviewedBy": { "type": ["string", "null"], "minLength": 1 }, "reviewedAt": { "$ref": "#/$defs/optionalInstant" },
        "committedAt": { "$ref": "#/$defs/instant" } },
      "if": { "properties": { "reviewStatus": { "const": "unreviewed" } } },
      "then": { "properties": { "reviewedBy": { "type": "null" }, "reviewedAt": { "type": "null" } } },
      "else": { "properties": { "reviewedBy": { "type": "string" }, "reviewedAt": { "type": "string" } } }
    },
    "provenance": {
      "description": "One evidence a claim revision cites: a whole source (extractionVersion, startOffset and endOffset null), a whole extraction version (offsets null), or a span of one, exactly as stored. A span's startOffset is at most its endOffset: a rule no JSON Schema states, which verifyExportManifest checks when given the data parts.",
      "type": "object", "additionalProperties": false, "required": ["collectionId", "claimId", "revision", "ordinal", "source"],
      "properties": { "collectionId": { "$ref": "#/$defs/id" }, "claimId": { "$ref": "#/$defs/id" }, "revision": { "$ref": "#/$defs/positive" },
        "ordinal": { "$ref": "#/$defs/count" },
        "source": { "type": "object", "additionalProperties": false, "required": ["collectionId", "sourceId", "extractionVersion", "startOffset", "endOffset"],
          "properties": { "collectionId": { "$ref": "#/$defs/id" }, "sourceId": { "$ref": "#/$defs/id" },
            "extractionVersion": { "type": ["integer", "null"], "minimum": 1 },
            "startOffset": { "type": ["integer", "null"], "minimum": 0 }, "endOffset": { "type": ["integer", "null"], "minimum": 0 } },
          "anyOf": [
            { "properties": { "startOffset": { "type": "null" }, "endOffset": { "type": "null" } } },
            { "properties": { "extractionVersion": { "type": "integer" }, "startOffset": { "type": "integer" }, "endOffset": { "type": "integer" } } }
          ] } }
    },
    "links": {
      "description": "One link live at the snapshot, at its revision there.",
      "type": "object", "additionalProperties": false,
      "required": ["collectionId", "linkId", "revision", "linkType", "deletionPolicy", "from", "to", "credentialId", "createdAt"],
      "properties": { "collectionId": { "$ref": "#/$defs/id" }, "linkId": { "$ref": "#/$defs/id" }, "revision": { "$ref": "#/$defs/positive" },
        "linkType": { "type": "string", "minLength": 1 }, "deletionPolicy": { "enum": ["restrict", "detach"] },
        "from": { "$ref": "#/$defs/endpoint" }, "to": { "$ref": "#/$defs/endpoint" },
        "credentialId": { "$ref": "#/$defs/id" }, "createdAt": { "$ref": "#/$defs/instant" } }
    },
    "endpoint": { "type": "object", "additionalProperties": false, "required": ["kind", "collectionId", "id"],
      "properties": { "kind": { "enum": ["record", "source", "claim"] }, "collectionId": { "$ref": "#/$defs/id" }, "id": { "$ref": "#/$defs/id" } } },
    "events": {
      "description": "One evidence lifecycle event committed at or before the snapshot: a source's or claim's deletion, or a link's creation, deletion or detachment (detachment has no credential). A deleted source or claim appears only here.",
      "type": "object", "additionalProperties": false,
      "required": ["eventId", "collectionId", "kind", "entityId", "revision", "operation", "credentialId", "committedAt"],
      "properties": { "eventId": { "$ref": "#/$defs/id" }, "collectionId": { "$ref": "#/$defs/id" }, "kind": { "enum": ["source", "claim", "link"] },
        "entityId": { "$ref": "#/$defs/id" }, "revision": { "$ref": "#/$defs/positive" }, "operation": { "enum": ["create", "delete", "detach"] },
        "credentialId": { "type": ["string", "null"], "minLength": 1 }, "committedAt": { "$ref": "#/$defs/instant" } },
      "anyOf": [{ "properties": { "kind": { "const": "link" } } }, { "properties": { "operation": { "const": "delete" } } }],
      "if": { "properties": { "operation": { "const": "detach" } } }, "then": { "properties": { "credentialId": { "type": "null" } } },
      "else": { "properties": { "credentialId": { "type": "string" } } }
    },
    "records": {
      "description": "One record live at the watermark, at its revision there, with its key: its normalized external key, or its own ID when generated.",
      "type": "object", "additionalProperties": false, "required": ["collectionId", "id", "keyMode", "key", "revision", "schemaVersion", "data"],
      "properties": { "collectionId": { "$ref": "#/$defs/id" }, "id": { "$ref": "#/$defs/id" },
        "keyMode": { "$ref": "#/$defs/keyMode" }, "key": { "$ref": "#/$defs/id" }, "revision": { "$ref": "#/$defs/positive" },
        "schemaVersion": { "$ref": "#/$defs/positive" }, "data": { "$ref": "#/$defs/json" } }
    },
    "revisions": {
      "description": "One record event published at or below the watermark, deletions included (data null), with its feed position and its record's key, which a deleted record keeps.",
      "type": "object", "additionalProperties": false,
      "required": ["collectionId", "id", "keyMode", "key", "revision", "eventId", "position", "operation", "schemaVersion", "credentialId", "committedAt", "data"],
      "properties": { "collectionId": { "$ref": "#/$defs/id" }, "id": { "$ref": "#/$defs/id" },
        "keyMode": { "$ref": "#/$defs/keyMode" }, "key": { "$ref": "#/$defs/id" }, "revision": { "$ref": "#/$defs/positive" },
        "eventId": { "$ref": "#/$defs/id" }, "position": { "$ref": "#/$defs/positive" }, "operation": { "enum": ["create", "replace", "patch", "delete"] },
        "schemaVersion": { "$ref": "#/$defs/positive" }, "credentialId": { "type": "string" },
        "committedAt": { "$ref": "#/$defs/instant" }, "data": { "$ref": "#/$defs/json" } }
    },
    "embeddings": {
      "description": "Optional accelerator: one stored embedding with the model it came from and the digest of the chunk it embeds. Never the only copy of any evidence; an importer may use it only where the chunk it rebuilds from authority has the same digest, and may ignore it. Format version 1 exporters may omit it.",
      "type": "object", "additionalProperties": false,
      "required": ["collectionId", "refKind", "refId", "revision", "chunkIndex", "contentSha256", "embedder", "embeddingModel", "modelVersion", "dimensions", "embedding"],
      "properties": { "collectionId": { "$ref": "#/$defs/id" }, "refKind": { "type": "string" }, "refId": { "$ref": "#/$defs/id" },
        "revision": { "$ref": "#/$defs/positive" }, "chunkIndex": { "$ref": "#/$defs/count" }, "contentSha256": { "$ref": "#/$defs/sha256" },
        "embedder": { "type": "string" }, "embeddingModel": { "type": "string" }, "modelVersion": { "type": "string" },
        "dimensions": { "$ref": "#/$defs/positive" }, "embedding": { "type": "array", "items": { "type": "number" } } }
    }
  }
}
