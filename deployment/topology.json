{
  "version": 2,
  "provider": "railway-postgresql",
  "environments": {
    "development": {
      "prefix": "stateplane-dev",
      "control": { "railwayRegion": "us-east4-eqdc4a", "database": "stateplane_control_dev", "originConnectionLimit": 5 },
      "cells": [
        { "id": "ap-southeast", "railwayRegion": "asia-southeast1-eqsg3a", "r2LocationHint": "apac", "originConnectionLimit": 5 },
        { "id": "us-east", "railwayRegion": "us-east4-eqdc4a", "r2LocationHint": "enam", "originConnectionLimit": 5 },
        { "id": "eu-west", "railwayRegion": "europe-west4-drams3a", "r2LocationHint": "weur", "originConnectionLimit": 5 }
      ]
    },
    "production": {
      "prefix": "stateplane-prod",
      "control": { "railwayRegion": "us-east4-eqdc4a", "database": "stateplane_control_prod", "originConnectionLimit": 5 },
      "cells": [
        { "id": "ap-southeast", "railwayRegion": "asia-southeast1-eqsg3a", "r2LocationHint": "apac", "originConnectionLimit": 5 },
        { "id": "us-east", "railwayRegion": "us-east4-eqdc4a", "r2LocationHint": "enam", "originConnectionLimit": 5 }
      ]
    }
  }
}
